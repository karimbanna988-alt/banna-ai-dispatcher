# Copy to .env (or set these as real shell env vars) -- never commit real values.

# Required for the "Quo Inbox (Live)" tab. Generate under Quo workspace
# settings -> API tab (requires workspace Owner/Admin). Treat this like a
# password -- it carries the same privileges as your Quo account.
QUO_API_KEY=your_quo_api_key_here

# Optional. On the very first poll (no checkpoint saved yet), how far back
# to look for messages rather than importing the org's entire history.
QUO_POLL_INITIAL_LOOKBACK_MINUTES=15
