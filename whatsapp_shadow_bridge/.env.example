# Copy to .env (gitignored) in this directory. Every default below keeps
# the bridge disabled and loopback-only.

# The one flag that gates everything. Must be the literal string "true"
# (case-insensitive) to enable -- anything else, including unset, means
# disabled.
WHATSAPP_SHADOW_ENABLED=false

# Where the linked-device session lives. Defaults to
# <repo root>/.runtime/whatsapp-shadow-session/ -- already gitignored.
# Only change this if you know what you're doing; never point it inside
# a directory that gets committed.
# WHATSAPP_SHADOW_SESSION_DIR=

# The bridge's own local admin/pairing server port -- 127.0.0.1 only,
# never exposed publicly.
WHATSAPP_SHADOW_LOCAL_PORT=8514

# The Python adapter's loopback-only URL and shared secret. Generate a
# random secret yourself (e.g. `openssl rand -hex 32`) and set the exact
# same value in the main project's .env as
# WHATSAPP_BRIDGE_ADAPTER_SECRET. Never commit this value anywhere.
WHATSAPP_SHADOW_ADAPTER_URL=http://127.0.0.1:8513
WHATSAPP_SHADOW_ADAPTER_SECRET=

WHATSAPP_SHADOW_MAX_MESSAGE_BYTES=8000
